MONGODB_URI=mongodb://127.0.0.1:27017/kinderlens
PARENT_PIN=change-this-local-pin
PARENT_SESSION_SECRET=replace-with-a-long-random-secret
# Account authentication uses the same session secret and HttpOnly cookies.
# Set NODE_ENV=production to add Secure to account session cookies.
NODE_ENV=development
# Comma-separated browser origins allowed to call the API with credentials.
# Example production value: https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000
# Set this when the API runs behind a trusted reverse proxy/load balancer.
TRUST_PROXY=false
